{
  "expo": {
    "name": "Antigravity",
    "slug": "antigravity",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "antigravity",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.antigravity.app"
    },
    "android": {
      "package": "com.antigravity.app",
      "kotlinVersion": "1.9.25",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withAppMonitor"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7003c2b3-b18b-462c-b0b1-e8ac36800d55"
      }
    }
  }
}
